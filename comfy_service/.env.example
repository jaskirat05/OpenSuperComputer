# Base URL of the Comfy API v2 proxy (for local ComfyUI, commonly port 8189).
# This is not the standard ComfyUI web UI URL on port 8188.
COMFY_API_KEY=

# Optional token used by the VFX Guru server when calling this service.
COMFY_SERVICE_TOKEN=

# By default, workflows are loaded from comfy_service/workflows.
# Point this at a directory of trusted ComfyUI API-format workflow JSON files.
COMFY_WORKFLOWS_DIR=

# Defaults to %LOCALAPPDATA%/VFXGuru/comfy-service on Windows.
COMFY_SERVICE_DATA_DIR=

# Browser origins allowed to call this service (if direct browser requests are used).
VFX_GURU_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
